    "components": {
        "schemas": {
            "TaskRequest": {
                "required": [
                    "title",
                    "description",
                    "status",
                    "importance",
                    "deadline"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "example": "Пример задачи"
                    },
                    "description": {
                        "type": "string",
                        "example": "Описание задачи"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "TODO",
                            "IN_PROGRESS",
                            "COMPLETED"
                        ]
                    },
                    "importance": {
                        "type": "integer",
                        "example": 3
                    },
                    "deadline": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-04-20 12:00:00"
                    }
                },
                "type": "object"
            },
            "Task": {
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "title": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "TODO",
                            "IN_PROGRESS",
                            "COMPLETED"
                        ]
                    },
                    "importance": {
                        "type": "integer"
                    },
                    "deadline": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "is_overdue": {
                        "type": "boolean"
                    },
                    "priority_score": {
                        "type": "number",
                        "format": "float"
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Tasks",
            "description": "Управление задачами"
        }
    ]
}